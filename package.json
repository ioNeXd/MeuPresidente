{
  "name": "screen-share-poc",
  "version": "2.0.0",
  "description": "WebRTC screen sharing P2P with advanced features",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "pkg ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "assets": ["public/**/*", "node_modules/socket.io/client-dist/socket.io.js"],
    "targets": ["node22-win-x64", "node22-linux-x64", "node22-macos-x64", "node22-macos-arm64"],
    "outputPath": "dist"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
